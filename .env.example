NODE_ENV=development
PORT=3009
LOG_LEVEL=info

DATABASE_URL=postgresql://finance:finance@localhost:5432/finance_zap?schema=public

BAILEYS_AUTH_DIR=./baileys_auth

MEDIA_STORAGE_DIR=./storage/media

# OCR em português (use por+eng se seus cupons tiverem muito texto em inglês)
TESSERACT_LANG=por

WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=
WHISPER_LANG=pt
# Contexto PT-BR para a transcrição. Vazio = padrão PT-BR embutido; "off" desativa.
WHISPER_PROMPT=

FFMPEG_PATH=ffmpeg

DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LOCALE=pt-BR

# Lembretes / agenda (opcional)
REMINDER_DEFAULT_DAY_HOUR=9
REMINDER_EARLY_MINUTES=15
